# Read-only login for dashboard data (created by sql/01_schema.sql).
# The admin screen uses SQL_CONN, SECRET_KEY and ADMIN_API_KEY from etl/.env.
API_SQL_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=AlDowyanReporting;UID=api_reader;PWD=<password>;TrustServerCertificate=yes
# Comma-separated list of origins allowed to call the API (the React app's URL)
CORS_ORIGINS=http://localhost:5173


# Report Pack e-mail (Administration › Report Pack holds server, port, sender and user; the password stays here)
SMTP_PASSWORD=
