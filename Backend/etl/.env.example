# Copy to .env and fill in. NEVER commit .env to Git.
# The API reads this file too, so the ETL and the web app share one configuration.

# SQL Server, read/write login (ODBC Driver 18). For Windows auth: Trusted_Connection=yes instead of UID/PWD.
SQL_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=AlDowyanReporting;UID=etl_user;PWD=<password>;TrustServerCertificate=yes

# Encrypts the D365 client secrets saved from the web screen. Generate ONCE and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you lose/change it, re-enter every client secret on the D365 Connections screen.
SECRET_KEY=

# Password for the "D365 Connections" admin screen (any long random string)
ADMIN_API_KEY=

# Incremental loads re-pull this many days before the last loaded date (catches late postings)
ETL_LOOKBACK_DAYS=7
# How many entities load at the same time (D365 throttles above ~8)
SYNC_WORKERS=4
# First-ever load of transactional entities starts here
ETL_INITIAL_FROM=2024-01-01

# OPTIONAL - only for running test_connection.py / create_tables.py without a saved connection
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_BASE_URL=
